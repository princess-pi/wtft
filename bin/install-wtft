#!/usr/bin/env bash
# install-wtft — put THIS repo's wtft build on PATH.
#
# Usage:
#   install-wtft                     build, install four entries into ~/bin, and
#                                    move any config file still at the old
#                                    princess-pi-tools path into
#                                    ~/.config/wtft/ (once — no fallback read)
#   install-wtft --check [--json]    report drift, write nothing (doctor mode)
#   install-wtft --dir <dir>         install somewhere else (the test seam)
#   install-wtft --json              machine-readable document, either mode
#   install-wtft -h | --help         this text (--json is ignored)
#   install-wtft --version           absolute path of THIS SCRIPT, not a version
#                                    number (--json is ignored)
#
# Exit codes:
#   0   installed, or --check found this host in sync; also --version and --help
#   1   drift: an artifact is missing, stale, not executable, or not built;
#       also an un-creatable --dir (status "no-dir")
#   2   in sync but SHADOWED on PATH by a different wtft
#   3   the build failed
#   4   in sync, but a config file is still at the old princess-pi-tools path
#       (status "config-left")
#   5   in sync, no config file left and wtft not shadowed, but the
#       claude-nsp-guard shim is SHADOWED: a different claude comes first on
#       PATH (status "nsp-guard-shadowed"). An ABSENT guard is not a failure.
#       Every other non-zero code outranks 5.
#  64   bad usage: unknown argument, --dir without a directory, --dir followed
#       by a flag or given an empty string, or no --dir on a host with HOME
#       unset. `--` is NOT an end-of-options marker. NO JSON DOCUMENT is emitted
#       for a usage error, even with --json.
#
# Human output goes to stdout only when STATUS is ok; every other status goes to
# stderr. Under --json the document goes to stdout in every case, carrying a
# configMigration array (from, to, state: "moved"|"left"|"none") and an nspGuard
# object (state: "ok"|"shadowed"|"absent", found, guard) alongside the
# existing artifacts/shadow fields.
#
# The claude-nsp-guard shim (princess-pi-tools, deployed as ~/bin/claude) is
# recognised by its identity line, "# nsp-guard-identity: 9a1c-claude-nsp-guard-
# sentinel" as a whole line in its first 160 lines. PATH is walked in order,
# skipping empty entries; a claude run by absolute path bypasses the guard.
#
# COPY, NOT SYMLINK — a copy survives the clone moving. The daemon keeps its
# .mjs extension (callers join "wtft-daemon.mjs") and also lands as `wtft-daemon`.
# This script does not install itself: REPO is derived from the script path, so
# run it as <clone>/bin/install-wtft. Install mode needs `bun install` first
# (bundled imports). Shadows are reported, never deleted.
#
# Contract: docs/spec-46-install-wtft.md

set -uo pipefail

MODE=install
JSON=0
DEST_DIR=""

# Escape every JSON control character (not just \ and "). Bash loop — portable
# across awk dialects. Bytes above 0x7f pass through unchanged.
json_str() {
  local s=$1 out= c i o
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    case $c in
      '\')     out+='\\' ;;
      '"')      out+='\"' ;;
      $'\n')    out+='\n' ;;
      $'\r')    out+='\r' ;;
      $'\t')    out+='\t' ;;
      $'\b')    out+='\b' ;;
      $'\f')    out+='\f' ;;
      *)        printf -v o '%d' "'$c"
                if (( o < 32 || o == 127 )); then printf -v c '\\u%04x' "$o"; fi
                out+=$c ;;
    esac
  done
  printf '%s' "$out"
}

# Shell single-quote for a path meant to be copied (close, escape ', reopen).
sh_squote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Absolute path with the final symlink followed (shadow compare + self_path).
resolve() {
  local p="$1" t n=0
  while [ -L "$p" ] && [ "$n" -lt 20 ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
    n=$((n + 1))
  done
  local d
  d="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || { printf '%s' "$p"; return; }
  printf '%s/%s' "$d" "$(basename "$p")"
}

# Resolve through the symlink — REPO is derived from this, not from dirname alone.
self_path() { resolve "$0"; }

# Absolute path without creating anything (--check must name a dir it refuses to make).
abs_dir() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *)  local here
        # Empty pwd is a failure, not root. Return (not exit) — we are in a command subshell.
        here="$(pwd -P 2>/dev/null)" || here=""
        [ -n "$here" ] || return 1
        printf '%s/%s' "$here" "$1" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check)   MODE=check ;;
    --json)    JSON=1 ;;
    --dir)     shift
               [ $# -gt 0 ] || { echo "install-wtft: --dir needs a directory" >&2; exit 64; }
               # Reject a flag or empty string as the directory value.
               case "$1" in --*|"") echo "install-wtft: --dir needs a directory, got '$1'" >&2; exit 64 ;; esac
               DEST_DIR="$1" ;;
    --version) self_path; exit 0 ;;
    -h|--help) sed -n '2,/^set -uo/p' "$(self_path)" | sed -e 's/^# \{0,1\}//' -e '$d'; exit 0 ;;
    *)         echo "install-wtft: unknown argument '$1'" >&2; exit 64 ;;
  esac
  shift
done

REPO="$(cd "$(dirname "$(self_path)")/.." && pwd -P)"
SRC_DIR="$REPO/bin"
if [ -z "$DEST_DIR" ]; then
  # set -u: unset HOME must not abort with a raw unbound-variable message.
  [ -n "${HOME:-}" ] || { echo "install-wtft: HOME is unset — pass --dir <dir>" >&2; exit 64; }
  DEST_DIR="$HOME/bin"
fi
DEST_DIR="$(abs_dir "$DEST_DIR")" || {
  echo "install-wtft: cannot resolve a relative --dir — the current directory is gone. Pass an absolute path." >&2
  exit 64
}

# Copies of the .mjs bundles + symlinks for the command names. The .mjs extension
# is load-bearing: callers join "wtft-daemon.mjs", and Node 18 needs it for ESM
# when the shebang invokes the file by name. Copy + sibling symlink — nothing
# points back at the clone.
COPIES=("wtft.mjs" "wtft-daemon.mjs")
LINKS=("wtft:wtft.mjs" "wtft-daemon:wtft-daemon.mjs")

STATUS=ok
EXIT=0

# ---
# CONFIG MIGRATION — move once from ~/.config/princess-pi-tools/ to ~/.config/wtft/.
# No runtime fallback read. Runs in every mode (independent of DEST_DIR/build).
# ---

OLD_CONFIG_DIR_NAME=princess-pi-tools
NEW_CONFIG_DIR_NAME=wtft
# old-basename:new-basename
CONFIG_MIGRATIONS=(
  "wtft.json:config.json"
  "token-budget.json:token-budget.json"
  "wtft-pricing.json:pricing.json"
  "wtft-harnesses.json:harnesses.json"
)

# $XDG_CONFIG_HOME, else $HOME/.config — empty if neither is set (skip migration).
config_home() {
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s' "$XDG_CONFIG_HOME"
  elif [ -n "${HOME:-}" ]; then printf '%s/.config' "$HOME"
  fi
}

CONFIG_JSON=""
CONFIG_LEFT=0
CONFIG_LEFT_LINES=""
CFG_HOME="$(config_home)"
if [ -n "$CFG_HOME" ]; then
  OLD_CFG_DIR="$CFG_HOME/$OLD_CONFIG_DIR_NAME"
  NEW_CFG_DIR="$CFG_HOME/$NEW_CONFIG_DIR_NAME"
  for pair in "${CONFIG_MIGRATIONS[@]}"; do
    old_name="${pair%%:*}"; new_name="${pair##*:}"
    old_path="$OLD_CFG_DIR/$old_name"
    new_path="$NEW_CFG_DIR/$new_name"
    is_dup=0
    left_reason=""
    if [ -f "$old_path" ]; then
      if [ ! -e "$new_path" ]; then
        if [ "$MODE" = install ]; then
          # Stage then hard-link: mid-move never half-writes; ln refuses an existing name.
          mkdir -p "$NEW_CFG_DIR" 2>/dev/null
          stage="$(mktemp "$NEW_CFG_DIR/.install-wtft.XXXXXX" 2>/dev/null)" || stage=""
          if [ -n "$stage" ] && cp "$old_path" "$stage" 2>/dev/null && ln "$stage" "$new_path" 2>/dev/null; then
            rm -f "$stage" 2>/dev/null
            # "moved" once data is at the new path — even if the old copy cannot be unlinked.
            if rm -f "$old_path" 2>/dev/null; then
              cfg_state=moved
              # >&2 so --json keeps exactly one document on stdout.
              echo "install-wtft: moved $old_path -> $new_path" >&2
            else
              cfg_state=moved
              echo "install-wtft: moved $old_path -> $new_path (the old copy could not be removed — remove $old_path by hand)" >&2
            fi
          else
            rm -f "$stage" 2>/dev/null
            cfg_state=left
            if [ -e "$new_path" ]; then
              left_reason="a file appeared at the new path during this run — re-run install-wtft"
            else
              left_reason="copy failed"
            fi
            echo "install-wtft: could not move $old_path -> $new_path ($left_reason)" >&2
          fi
        else
          cfg_state=left   # --check never mutates
          left_reason="not yet migrated"
        fi
      elif cmp -s "$old_path" "$new_path" 2>/dev/null; then
        # Identical: retry removing the stale duplicate in install mode.
        if [ "$MODE" = install ] && rm -f "$old_path" 2>/dev/null; then
          cfg_state=moved
          echo "install-wtft: removed a stale duplicate at $old_path (identical content already lives at $new_path)" >&2
        else
          cfg_state=left
          is_dup=1
          left_reason="identical, safe to delete"
        fi
      else
        # Real conflict — never overwrite; a human decides.
        cfg_state=left
        left_reason="conflicts with a DIFFERENT file already at the new path"
      fi
    else
      cfg_state=none
    fi
    if [ "$cfg_state" = left ]; then
      CONFIG_LEFT=1
      if [ "$is_dup" = 1 ]; then
        CONFIG_LEFT_LINES="$CONFIG_LEFT_LINES   $old_path (identical to $new_path — safe to delete)
"
      else
        CONFIG_LEFT_LINES="$CONFIG_LEFT_LINES   $old_path (wanted at $new_path — ${left_reason:-not yet migrated})
"
      fi
    fi
    [ -z "$CONFIG_JSON" ] || CONFIG_JSON="$CONFIG_JSON,"
    CONFIG_JSON="$CONFIG_JSON{\"from\":\"$(json_str "$old_path")\",\"to\":\"$(json_str "$new_path")\",\"state\":\"$cfg_state\"}"
  done
fi

# Every exit past the argument loop goes through here. Exit 64 (usage) is the
# exception: no JSON document.
finish() {
  if [ "$JSON" = 1 ]; then
    printf '{"schema":"install-wtft@1","mode":"%s","dir":"%s","status":"%s","onPath":%s,"artifacts":[%s],"shadow":%s,"configMigration":[%s],"nspGuard":{"state":"%s","found":%s,"guard":%s}}\n' \
      "$MODE" "$(json_str "$DEST_DIR")" "$STATUS" "${ON_PATH:-false}" "${STATE_JSON:-}" "${SHADOW_JSON:-null}" "${CONFIG_JSON:-}" \
      "${NSP_GUARD_STATE:-absent}" "${NSPGUARD_FOUND_JSON:-null}" "${NSPGUARD_GUARD_JSON:-null}"
  else
    case "$STATUS" in
      build-failed) echo "❌ install-wtft: build failed — see the output above" >&2 ;;
      no-dir)       echo "❌ install-wtft: cannot create $DEST_DIR" >&2 ;;
      drift)        echo "❌ install-wtft: $DEST_DIR does not match $SRC_DIR" >&2
                    printf '%s' "${STATE_LINES:-}" >&2
                    echo "   Run: $(self_path)" >&2
                    # Report a coexisting shadow even when drift wins the exit code.
                    [ "${SHADOW_JSON:-null}" = null ] || printf '   Also: PATH resolves wtft to %s — rm %s\n' "$WINNER" "$(sh_squote "$WINNER")" >&2
                    [ "${NSP_GUARD_STATE:-absent}" != shadowed ] || printf '   Also: PATH resolves claude to %s before claude-nsp-guard at %s\n' "$NSP_FOUND" "$NSP_GUARD" >&2 ;;
      config-left)  if [ "$MODE" = check ]; then
                      echo "⚠️  install-wtft: $DEST_DIR is in sync, but a config file is still at the old path (#156):" >&2
                    else
                      echo "⚠️  install-wtft: installed into $DEST_DIR, but a config file is still at the old path (#156):" >&2
                    fi
                    printf '%s' "${CONFIG_LEFT_LINES:-}" >&2
                    if [ "$MODE" = check ]; then echo "   Run: $(self_path)" >&2
                    else echo "   Move it by hand, or delete whichever copy is stale." >&2
                    fi
                    # Report a coexisting shadow even when config-left wins the exit code.
                    [ "${SHADOW_JSON:-null}" = null ] || printf '   Also: PATH resolves wtft to %s — rm %s\n' "$WINNER" "$(sh_squote "$WINNER")" >&2
                    [ "${NSP_GUARD_STATE:-absent}" != shadowed ] || printf '   Also: PATH resolves claude to %s before claude-nsp-guard at %s\n' "$NSP_FOUND" "$NSP_GUARD" >&2 ;;
      shadowed)     if [ "$MODE" = check ]; then
                      echo "⚠️  install-wtft: $DEST_DIR is in sync, but PATH resolves wtft to $WINNER" >&2
                    else
                      echo "⚠️  install-wtft: installed into $DEST_DIR, but PATH resolves wtft to $WINNER" >&2
                    fi
                    printf '   Run: rm %s\n' "$(sh_squote "$WINNER")" >&2
                    [ "${NSP_GUARD_STATE:-absent}" != shadowed ] || printf '   Also: PATH resolves claude to %s before claude-nsp-guard at %s\n' "$NSP_FOUND" "$NSP_GUARD" >&2 ;;
      nsp-guard-shadowed)
                    echo "⚠️  install-wtft: PATH resolves claude to $NSP_FOUND before claude-nsp-guard at $NSP_GUARD" >&2
                    echo "   Put $(dirname "$NSP_GUARD")'s PATH entry before $(dirname "$NSP_FOUND")'s. Nothing is deleted." >&2
                    [ "${ON_PATH:-false}" = true ] || echo "   Also: no wtft on PATH resolves to $DEST_DIR/wtft — add $DEST_DIR to PATH." >&2 ;;
      ok)           if [ "$MODE" = check ]; then echo "✅ install-wtft: $DEST_DIR is in sync with $SRC_DIR"
                    else echo "✅ install-wtft: installed into $DEST_DIR"; fi
                    # Not an error, but say so — a green run must not hide an unusable PATH.
                    [ "${ON_PATH:-false}" = true ] || echo "   Note: no wtft on PATH resolves to $DEST_DIR/wtft — add $DEST_DIR to PATH."
                    # The guard ships from a private repo — absence is a normal host, not drift.
                    [ "${NSP_GUARD_STATE:-absent}" != absent ] || echo "   Note: no claude-nsp-guard on PATH (ships from princess-pi-tools; absent is not a failure)." ;;
    esac
  fi
  exit "$EXIT"
}

# ---
# Build first in install mode. --check never builds. Build output to stderr
# so --json cannot swallow an exit-3 reader's only clue.
# ---
if [ "$MODE" = install ]; then
  if ! (cd "$REPO" && bun run build >&2); then
    STATUS=build-failed
    EXIT=3
  fi
fi

# ---
# Install, then evaluate what is on disk. mkdir only in install mode.
# ---
if [ "$MODE" = install ] && [ "$STATUS" != build-failed ]; then
  # Fall through on no-dir so every JSON field is measured (not defaulted).
  mkdir -p "$DEST_DIR" 2>/dev/null || { STATUS=no-dir; EXIT=1; }
  for name in "${COPIES[@]}"; do
    src="$SRC_DIR/$name"; dst="$DEST_DIR/$name"
    [ -f "$src" ] || continue
    # Stage then mv: cp -f follows a destination symlink / blocks on a FIFO.
    # mktemp (O_EXCL), not a predictable "$dst.$$".
    stage="$(mktemp "$DEST_DIR/.install-wtft.XXXXXX" 2>/dev/null)" || stage=""
    if [ -n "$stage" ] && cp -f "$src" "$stage" 2>/dev/null && chmod 0755 "$stage" 2>/dev/null && mv -f "$stage" "$dst" 2>/dev/null; then
      :
    else
      rm -f "$stage" 2>/dev/null
      echo "install-wtft: cannot write $dst" >&2
    fi
  done
  for entry in "${LINKS[@]}"; do
    link="$DEST_DIR/${entry%%:*}"; target="${entry##*:}"
    # Same source guard as the copy loop — no dangling command names.
    [ -f "$SRC_DIR/$target" ] || continue
    # Relative target so the directory can be moved or copied.
    ln -sfn "$target" "$link" 2>/dev/null || echo "install-wtft: cannot link $link" >&2
  done
fi

STATE_JSON=""
STATE_LINES=""
EVAL_LIST=()
for name in "${COPIES[@]}"; do EVAL_LIST+=("copy:$name:$name"); done
for entry in "${LINKS[@]}"; do EVAL_LIST+=("link:${entry%%:*}:${entry##*:}"); done

for spec in "${EVAL_LIST[@]}"; do
  kind="${spec%%:*}"; rest="${spec#*:}"; name="${rest%%:*}"; target="${rest##*:}"
  src="$SRC_DIR/$target"
  dst="$DEST_DIR/$name"
  if [ "$kind" = link ]; then
    if   [ ! -f "$src" ]; then state=no-source
    elif [ ! -L "$dst" ]; then state=$( [ -e "$dst" ] && echo not-a-link || echo missing )
    elif [ "$(readlink "$dst")" != "$target" ]; then state=wrong-target
    else state=ok
    fi
  elif [ ! -f "$src" ]; then state=no-source
  elif [ ! -f "$dst" ]; then state=missing
  elif ! cmp -s "$src" "$dst"; then state=stale
  elif [ ! -x "$dst" ]; then state=not-executable
  else state=ok
  fi
  case "$state:$STATUS" in ok:*|*:build-failed|*:no-dir) ;; *) STATUS=drift ;; esac
  [ -z "$STATE_JSON" ] || STATE_JSON="$STATE_JSON,"
  STATE_JSON="$STATE_JSON{\"name\":\"$(json_str "$name")\",\"path\":\"$(json_str "$dst")\",\"state\":\"$state\"}"
  # Built alongside JSON (do not re-parse STATE_JSON for the human lines).
  STATE_LINES="$STATE_LINES   $name: $state
"
done
[ "$STATUS" = drift ] && EXIT=1

# config-left only when nothing worse (build-failed/no-dir/drift outrank it).
[ "$STATUS" = ok ] && [ "$CONFIG_LEFT" = 1 ] && { STATUS=config-left; EXIT=4; }

# ---
# Shadow: PATH's wtft. onPath is reported, never fatal. Drift/config-left outrank it.
# ---
SHADOW_JSON=null
ON_PATH=false
WINNER="$(command -v wtft 2>/dev/null || true)"
if [ -n "$WINNER" ]; then
  if [ "$(resolve "$WINNER")" = "$(resolve "$DEST_DIR/wtft")" ]; then
    ON_PATH=true
  else
    SHADOW_JSON="{\"found\":\"$(json_str "$WINNER")\",\"remedy\":\"rm $(json_str "$(sh_squote "$WINNER")")\"}"
    if [ "$STATUS" = ok ]; then STATUS=shadowed; EXIT=2; fi
  fi
fi

# ---
# NSP GUARD: does `claude` on PATH resolve to princess-pi-tools'
# claude-nsp-guard? Never fatal on its own — absent is a normal host, not
# drift — but a guard that loses the PATH race guards nothing. Outranked by
# every other status, so it is scanned last and only escalates an "ok".
# ---

# install-workflow-tools (princess-pi-tools docs/dev-workflow-spec.md) matches
# this exact line before it overwrites ~/bin/claude with the guard.
NSP_GUARD_SENTINEL='# nsp-guard-identity: 9a1c-claude-nsp-guard-sentinel'

# The sentinel must be a whole line, not a substring — a script that merely
# echoes it is not the guard. A real `claude` can be a large binary, so read
# only the first 160 lines rather than slurping the whole file.
is_nsp_guard() {
  [ -f "$1" ] && [ -x "$1" ] || return 1
  head -n 160 "$1" 2>/dev/null | grep -aqxF -- "$NSP_GUARD_SENTINEL"
}

NSP_FOUND=""
NSP_GUARD=""
IFS=: read -r -a NSP_PATH_DIRS <<< "$PATH"
for d in "${NSP_PATH_DIRS[@]}"; do
  [ -n "$d" ] || continue
  f="$d/claude"
  [ -f "$f" ] && [ -x "$f" ] || continue
  [ -n "$NSP_FOUND" ] || NSP_FOUND="$f"
  [ -n "$NSP_GUARD" ] || { is_nsp_guard "$f" && NSP_GUARD="$f"; }
done

if [ -z "$NSP_GUARD" ]; then NSP_GUARD_STATE=absent
elif [ "$NSP_FOUND" = "$NSP_GUARD" ]; then NSP_GUARD_STATE=ok
else NSP_GUARD_STATE=shadowed
fi

if [ "$NSP_GUARD_STATE" = shadowed ] && [ "$STATUS" = ok ]; then
  STATUS=nsp-guard-shadowed
  EXIT=5
fi

NSPGUARD_FOUND_JSON=null
[ -z "$NSP_FOUND" ] || NSPGUARD_FOUND_JSON="\"$(json_str "$NSP_FOUND")\""
NSPGUARD_GUARD_JSON=null
[ -z "$NSP_GUARD" ] || NSPGUARD_GUARD_JSON="\"$(json_str "$NSP_GUARD")\""

finish
