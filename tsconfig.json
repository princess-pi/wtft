{
	// TS7 (native compiler) typecheck config, restored with the Phase-5 transfer (#37).
	//
	// WHY THIS FILE EXISTS AT ALL, rather than being a nicety: a test depends on it.
	// `tests/wtft-179-daemon-health-reason.test.ts` V2 is a negative control — it writes
	// a probe comparing a DaemonHealthReason against a value outside the union, runs
	// `bun run typecheck`, and requires tsc to REJECT it. Without a checker the union is
	// decorative: before #179 split it out, `health.reason === "daemon not fuond"`
	// compiled happily to an always-false branch. A compiler gate that cannot be shown
	// to go red is indistinguishable from no gate (the lesson of #168).
	//
	// Scope: bin/ CLIs and the extensions/lib files they transitively import — which is
	// what the probe needs, since it imports extensions/lib/wtft-daemon-lib.ts.
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		// bin/wtft.ts imports docs/manifests/wtft-cmd.json so the BUNDLE carries its
		// own help text (#36) — without this the import is a type error.
		"resolveJsonModule": true,
		"moduleResolution": "nodenext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		// `["node"]` DELIBERATELY excludes the `bun-types` devDependency, and that exclusion
		// is load-bearing rather than an oversight (PR review flagged it as the reverse).
		// bin/*.ts is bundled by build.ts into bin/*.mjs, which must run on STOCK NODE —
		// `engines.node >= 18`, and the Node Toolchain Standard's "bun is internal only,
		// never a consumer requirement". A `Bun.*` global reaching bin/ would compile here
		// and then die at a consumer's `npx`. Excluding bun-types turns that into a compile
		// error instead, so this is a true positive, not the false one it looks like:
		//   bin/__bun_types_probe__.ts(2,18): error TS2868: Cannot find name 'Bun'.
		//   Do you need to install type definitions for Bun? Try `npm i --save-dev @types/bun`
		// Verified by probe against tsc 7.0.2, 2026-08-30, and re-run at review round 2.
		// TS2868 is the Bun-SPECIFIC diagnostic, not the generic "Cannot find name" TS2304
		// a reader may expect — review round 2 called this a typo; it is the literal output.
		// build.ts itself uses Bun.build freely — it is outside `include` because it is a
		// build tool, not shipped output.
		"types": ["node"]
	},
	// No `allowJs`: unlike princess-pi-tools, this repo has no hand-written .js module
	// under extensions/ — every `./x.js` specifier resolves to a real .ts under nodenext.
	// Add it back only when a genuine .js module arrives, and say which one.
	//
	// This glob matches bin/wtft.ts and bin/wtft-daemon.ts, the two tracked SOURCES.
	// The bin/*.mjs beside them are gitignored build output and package.json's `bin`
	// map points at those, so a reader who sees only the diff can conclude this glob
	// matches nothing — PR review did. It does not: `git ls-files bin` lists both .ts.
	"include": ["bin/**/*.ts"]
}
