#!/usr/bin/env bash
# install-wtft — put THIS repo's wtft build on PATH.
#
# Why this exists (#46): `wtft` on the box it was written for resolved to
# ~/.bun/bin/wtft -> the princess-pi-tools clone, reporting 1.1.0 while this
# repo built 1.0.0 — so #36, #37, #39 and #18 were all absent from the command
# that actually ran, and lazy session discovery got implemented twice, once in
# each repo. `install-workflow-tools` has never contained a single wtft
# reference: the route was `bun link` plus that repo's package.json bin map, so
# there was nothing to remove from that installer. This is the missing half of
# the Phase-5 extraction — it copied the sources and never moved the install.
#
# Usage:
#   install-wtft                     build, then install four entries into ~/bin
#   install-wtft --check [--json]    report drift, write nothing (doctor mode)
#   install-wtft --dir <dir>         install somewhere else (the test seam)
#   install-wtft --json              machine-readable document, either mode
#   install-wtft -h | --help         this text (--json is ignored)
#   install-wtft --version           absolute path of THIS SCRIPT, not a version
#                                    number (--json is ignored)
#
# Exit codes:
#   0   installed, or --check found this host in sync; also --version and --help
#   1   drift: an artifact is missing, stale, not executable, or not built;
#       also an un-creatable --dir (status "no-dir")
#   2   in sync but SHADOWED on PATH by a different wtft
#   3   the build failed
#  64   bad usage: unknown argument, --dir without a directory, --dir followed
#       by a flag or given an empty string, or no --dir on a host with HOME
#       unset. `--` is NOT an end-of-options marker. NO JSON DOCUMENT is emitted
#       for a usage error, even with --json.
#
# Human output goes to stdout only when STATUS is ok; every other status goes to
# stderr. Under --json the document goes to stdout in every case.
#
# 1 and 64 match install-workflow-tools deliberately, so the two installers
# never disagree about what a number means. 2 is its own code because its
# remedy is a different verb: re-running this script cannot fix a PATH shadow.
# Drift outranks shadow when both hold — a shadowed copy of the wrong bytes is
# still the wrong bytes, and fixing drift is the prerequisite.
#
# COPY, NOT SYMLINK. A symlink into the clone was the only workable option
# before #36, because the artifacts still carried bare imports and only ran
# from a directory with node_modules in an ancestor. #36 made them
# self-contained, so a copy runs anywhere. The copy survives the clone moving
# or being deleted, and reports a real version instead of a -dev stamp against
# a working tree that has since changed; the cost is re-running this after each
# build, which --check is what makes visible.
#
# THE DAEMON KEEPS ITS .mjs EXTENSION. bin/wtft.ts computes
# `daemonDir = dirname(fileURLToPath(import.meta.url))` and joins
# "wtft-daemon.mjs" onto it, at four sites in that file and a fifth in
# extensions/lib/wtft-cli-shared.ts (spawnWtftDaemon) — grepping only bin/wtft.ts
# undercounts the dependency surface. Installing the daemon as `wtft-daemon`
# ALONE would leave --watch unable to find it while everything else kept
# working — the failure mode hardest to notice. It lands under both names.
#
# THIS SCRIPT DOES NOT INSTALL ITSELF, unlike install-workflow-tools. REPO is
# derived from the script's own location, so a copy in ~/bin would compute
# REPO=~ and compare the artifacts against a directory that is not this clone.
# Run it by path: <clone>/bin/install-wtft.
#
# INSTALL MODE NEEDS `bun install` FIRST — not because build.ts imports anything
# beyond node:fs and node:path, but because Bun.build resolves the ENTRYPOINTS'
# imports (@princess-pi/libs, wcwidth) and noticeFor reads each bundled
# package's LICENSE out of node_modules. A clone without them exits 3.
#
# SHADOWS ARE REPORTED, NEVER DELETED. The precedent is
# install-workflow-tools, which reports a retired hook and prints its `rm`
# rather than removing it: silently deleting an executable another repo manages
# is the same class of move as silently installing one. A `bun link` deleted
# here would also return the next time anyone re-links that repo, so deleting
# it would be both rude and ineffective.
#
# Contract: docs/spec-46-install-wtft.md

set -uo pipefail

MODE=install
JSON=0
DEST_DIR=""

# EVERY JSON control character, not just backslash and quote. A newline or tab
# in a path is legal on this filesystem and produced a document `JSON.parse`
# rejects — on a tool whose entire point is a machine-readable surface. The spec
# used to carry this as a documented limit; a documented limit that costs eight
# lines to remove was not worth documenting.
json_str() {
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN {
      RS = "^$"; ORS = ""
      for (i = 0; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
      esc["\b"] = "\\b"; esc["\f"] = "\\f"; esc["\n"] = "\\n"
      esc["\r"] = "\\r"; esc["\t"] = "\\t"
      esc["\\"] = "\\\\"; esc["\""] = "\\\""
      esc[sprintf("%c", 127)] = "\\u007f"
    }
    { n = length($0); for (i = 1; i <= n; i++) { c = substr($0, i, 1); printf "%s", (c in esc ? esc[c] : c) } }'
}

# Single-quote for a shell, the way a shell actually requires: close the quote,
# escape the apostrophe, reopen. The printed `rm` is meant to be COPIED, so a
# path containing an apostrophe did not merely fail — it broke out of the quoted
# word and handed the rest to the shell as syntax. Third iteration of this bug:
# first the JSON field was unquoted, then the printed line emitted double quotes
# inside single ones, and now the quoting is correct for every path.
sh_squote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Absolute path with the FINAL symlink followed. Two callers need it and both
# broke without it: the shadow comparison (a `ln -s` at our own copy runs our own
# bytes) and self_path below.
resolve() {
  local p="$1" t n=0
  while [ -L "$p" ] && [ "$n" -lt 20 ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
    n=$((n + 1))
  done
  local d
  d="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || { printf '%s' "$p"; return; }
  printf '%s/%s' "$d" "$(basename "$p")"
}

# THROUGH the symlink, not just the directory holding it. REPO is derived from
# this, so a symlinked install-wtft in ~/bin used to compute REPO=$HOME and
# SRC_DIR=$HOME/bin — the DEFAULT DEST_DIR. Every artifact was then compared
# against itself and --check reported "ok" on a payload it had just called
# stale. A doctor that always says healthy is worse than no doctor.
self_path() { resolve "$0"; }

# Absolute path, WITHOUT creating anything — --check must be able to name a
# directory it refuses to make. A non-existent path is made absolute against
# $PWD lexically rather than resolved, which is all a report needs.
abs_dir() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *)  printf '%s/%s' "$(pwd -P)" "$1" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check)   MODE=check ;;
    --json)    JSON=1 ;;
    --dir)     shift
               [ $# -gt 0 ] || { echo "install-wtft: --dir needs a directory" >&2; exit 64; }
               # A flag here is a forgotten value, not a directory name: `--dir
               # --json` used to install into a directory literally called
               # "--json" and still exit 0.
               # A flag OR an empty string: `--dir ""` (an unexpanded caller
               # variable) used to fall through to the `-z` test below and
               # silently retarget the real ~/bin.
               case "$1" in --*|"") echo "install-wtft: --dir needs a directory, got '$1'" >&2; exit 64 ;; esac
               DEST_DIR="$1" ;;
    --version) self_path; exit 0 ;;
    -h|--help) sed -n '2,/^set -uo/p' "$(self_path)" | sed -e 's/^# \{0,1\}//' -e '$d'; exit 0 ;;
    *)         echo "install-wtft: unknown argument '$1'" >&2; exit 64 ;;
  esac
  shift
done

REPO="$(cd "$(dirname "$(self_path)")/.." && pwd -P)"
SRC_DIR="$REPO/bin"
if [ -z "$DEST_DIR" ]; then
  # Not `$HOME/bin` under `set -u`: an unset HOME aborted with a raw bash
  # "unbound variable" and no document at all.
  [ -n "${HOME:-}" ] || { echo "install-wtft: HOME is unset — pass --dir <dir>" >&2; exit 64; }
  DEST_DIR="$HOME/bin"
fi
DEST_DIR="$(abs_dir "$DEST_DIR")"

# Two copies and two symlinks. The .mjs EXTENSION IS LOAD-BEARING TWICE OVER:
#
#   1. bin/wtft.ts joins the literal "wtft-daemon.mjs" onto daemonDir, so the
#      daemon must sit beside the command under exactly that name.
#   2. NODE 18 NEEDS IT TO SEE ESM. An extensionless copy of the bundle, run by
#      its own shebang, dies on `import * as fs from "node:fs"`. Node's
#      extensionless module detection is unflagged from 20.19.0 and 22.7.0, so
#      the versions that need the extension are 18.x and early 20.x — and
#      /usr/bin/node here is 18.19.1, exactly the floor `engines: >=18`
#      promises.
#
#      MEASURED, and narrower than an earlier version of this comment claimed.
#      That one said "exit 1 on 18, 20 and 22", which conflated two causes: it
#      was taken while the type-stripping shebang above was still in place, so
#      it credited the missing extension with a failure the shebang caused.
#      Re-measured against the fixed build — `cp bin/wtft.mjs $D/wtft && chmod
#      +x $D/wtft && PATH=$(dirname $NODE):/usr/bin:/bin $D/wtft --version` —
#      exit 1 on 18.19.1 only; 0 on 20.20.2, 22.22.3 and 24.16.0. One supported
#      major is enough to need the symlink; overstating it was not.
#
# So the payload is a COPY (it survives the clone moving) and the command name
# is a SYMLINK BESIDE IT (node resolves to the .mjs realpath, which is in the
# same directory, so daemonDir still finds the daemon). Nothing points back at
# the clone.
#
# The whole class was invisible because every test ran `node <file>`, which
# takes an explicit entry point and detects the module type. No test had ever
# invoked the artifact the way a consumer does: by typing its name.
COPIES=("wtft.mjs" "wtft-daemon.mjs")
LINKS=("wtft:wtft.mjs" "wtft-daemon:wtft-daemon.mjs")

STATUS=ok
EXIT=0

# Emit the document (or the human lines) and leave. Every exit PAST THE ARGUMENT
# LOOP goes through here, so `--json` has no path that exits without a document —
# three of them used to. Exit 64 is the stated exception: a usage error is
# reported on stderr and carries no document, because the arguments that would
# say what to report are the thing that is wrong.
finish() {
  if [ "$JSON" = 1 ]; then
    printf '{"schema":"install-wtft@1","mode":"%s","dir":"%s","status":"%s","onPath":%s,"artifacts":[%s],"shadow":%s}\n' \
      "$MODE" "$(json_str "$DEST_DIR")" "$STATUS" "${ON_PATH:-false}" "${STATE_JSON:-}" "${SHADOW_JSON:-null}"
  else
    case "$STATUS" in
      build-failed) echo "❌ install-wtft: build failed — see the output above" >&2 ;;
      no-dir)       echo "❌ install-wtft: cannot create $DEST_DIR" >&2 ;;
      drift)        echo "❌ install-wtft: $DEST_DIR does not match $SRC_DIR" >&2
                    printf '%s' "${STATE_LINES:-}" >&2
                    echo "   Run: $(self_path)" >&2
                    # A shadow found alongside drift is still worth saying. It
                    # loses the EXIT CODE to drift (fixing the bytes comes
                    # first), not the report — otherwise a human needs two runs
                    # to learn about two problems.
                    [ "${SHADOW_JSON:-null}" = null ] || printf '   Also: PATH resolves wtft to %s — rm %s\n' "$WINNER" "$(sh_squote "$WINNER")" >&2 ;;
      shadowed)     if [ "$MODE" = check ]; then
                      echo "⚠️  install-wtft: $DEST_DIR is in sync, but PATH resolves wtft to $WINNER" >&2
                    else
                      echo "⚠️  install-wtft: installed into $DEST_DIR, but PATH resolves wtft to $WINNER" >&2
                    fi
                    # printf, not echo: the shell-quoting idiom this used
                    # emitted rm '"<path>"' — double quotes INSIDE the single
                    # ones — so the printed command failed on the path it named.
                    # Only the JSON field had been fixed.
                    printf '   Run: rm %s\n' "$(sh_squote "$WINNER")" >&2 ;;
      ok)           if [ "$MODE" = check ]; then echo "✅ install-wtft: $DEST_DIR is in sync with $SRC_DIR"
                    else echo "✅ install-wtft: installed into $DEST_DIR"; fi
                    # Not an error: a directory that is not on PATH is a
                    # host-wiring fact. But saying nothing let a green run hide
                    # a command nobody can type.
                    [ "${ON_PATH:-false}" = true ] || echo "   Note: no wtft on PATH resolves to $DEST_DIR/wtft — add $DEST_DIR to PATH." ;;
    esac
  fi
  exit "$EXIT"
}

# ---
# Build first in install mode. --check never builds: it writes nothing, and a
# doctor that modifies the tree it is diagnosing is not a doctor. Build output
# goes straight to stderr rather than into a variable, so `--json` cannot
# swallow the one thing an exit-3 reader needs.
# ---
if [ "$MODE" = install ]; then
  if ! (cd "$REPO" && bun run build >&2); then
    STATUS=build-failed
    EXIT=3
  fi
fi

# ---
# Install, then evaluate. Evaluating AFTER the copy means the reported state is
# what is on disk now, not what the script intended to put there.
#
# mkdir lives HERE, in install mode only. It used to run unconditionally during
# argument handling, which made `--check` create directories — a doctor mode
# with a write side effect, and the claim "writes nothing" was false in the one
# place it was stated three times.
# ---
if [ "$MODE" = install ] && [ "$STATUS" != build-failed ]; then
  # No early finish: it emitted "artifacts":[] against a schema that promises
  # four records, plus the ${ON_PATH:-false}/${SHADOW_JSON:-null} DEFAULTS, which
  # a caller reads as measurements. Falling through means every field in the
  # no-dir document was actually measured.
  mkdir -p "$DEST_DIR" 2>/dev/null || { STATUS=no-dir; EXIT=1; }
  for name in "${COPIES[@]}"; do
    src="$SRC_DIR/$name"; dst="$DEST_DIR/$name"
    [ -f "$src" ] || continue
    # WRITE BESIDE, THEN RENAME OVER. `cp -f` writes THROUGH a destination
    # symlink, so an existing `<dir>/wtft.mjs` pointing anywhere else had that
    # file overwritten with the bundle and chmod'ed 0755 — verified on a
    # throwaway file, which came back holding our shebang. It also blocks
    # forever on a FIFO. `mv` replaces the entry itself, follows nothing, and
    # makes the swap atomic, which matters when the command being replaced may
    # be running.
    #
    # A write failure is still only a stderr line: STATUS stays `drift` and the
    # printed remedy is "run this again", which for a permissions problem is the
    # wrong advice. Fixing that properly needs a write-failure state in the
    # schema, which is more than this branch should change.
    stage="$dst.install-wtft.$$"
    if cp -f "$src" "$stage" 2>/dev/null && chmod 0755 "$stage" 2>/dev/null && mv -f "$stage" "$dst" 2>/dev/null; then
      :
    else
      rm -f "$stage" 2>/dev/null
      echo "install-wtft: cannot write $dst" >&2
    fi
  done
  for entry in "${LINKS[@]}"; do
    link="$DEST_DIR/${entry%%:*}"; target="${entry##*:}"
    # The same source guard the copy loop has. Without it, a tree with no build
    # still got its command names written — as DANGLING symlinks, so `wtft`
    # existed and exited 127 with "no such file or directory".
    [ -f "$SRC_DIR/$target" ] || continue
    # Relative target, so the whole directory can be moved or copied.
    ln -sfn "$target" "$link" 2>/dev/null || echo "install-wtft: cannot link $link" >&2
  done
fi

STATE_JSON=""
STATE_LINES=""
EVAL_LIST=()
for name in "${COPIES[@]}"; do EVAL_LIST+=("copy:$name:$name"); done
for entry in "${LINKS[@]}"; do EVAL_LIST+=("link:${entry%%:*}:${entry##*:}"); done

for spec in "${EVAL_LIST[@]}"; do
  kind="${spec%%:*}"; rest="${spec#*:}"; name="${rest%%:*}"; target="${rest##*:}"
  src="$SRC_DIR/$target"
  dst="$DEST_DIR/$name"
  if [ "$kind" = link ]; then
    if   [ ! -f "$src" ]; then state=no-source
    elif [ ! -L "$dst" ]; then state=$( [ -e "$dst" ] && echo not-a-link || echo missing )
    elif [ "$(readlink "$dst")" != "$target" ]; then state=wrong-target
    else state=ok
    fi
  elif [ ! -f "$src" ]; then state=no-source
  elif [ ! -f "$dst" ]; then state=missing
  elif ! cmp -s "$src" "$dst"; then state=stale
  elif [ ! -x "$dst" ]; then state=not-executable
  else state=ok
  fi
  case "$state:$STATUS" in ok:*|*:build-failed|*:no-dir) ;; *) STATUS=drift ;; esac
  [ -z "$STATE_JSON" ] || STATE_JSON="$STATE_JSON,"
  STATE_JSON="$STATE_JSON{\"name\":\"$(json_str "$name")\",\"path\":\"$(json_str "$dst")\",\"state\":\"$state\"}"
  # Built alongside the JSON rather than parsed back out of it. The previous
  # version piped STATE_JSON through `tr ',' '\n'`, which splits each record
  # across three lines so name and state never share one — the sed matched
  # nothing and the human drift report named no artifact at all.
  STATE_LINES="$STATE_LINES   $name: $state
"
done
[ "$STATUS" = drift ] && EXIT=1

# ---
# Shadow: whichever `wtft` PATH actually resolves. `onPath` is reported but
# never fatal — a dir that is not on PATH is a host-wiring fact, not drift.
# Drift outranks shadow: the wrong bytes are the wrong bytes.
# ---
SHADOW_JSON=null
ON_PATH=false
WINNER="$(command -v wtft 2>/dev/null || true)"
if [ -n "$WINNER" ]; then
  if [ "$(resolve "$WINNER")" = "$(resolve "$DEST_DIR/wtft")" ]; then
    ON_PATH=true
  else
    SHADOW_JSON="{\"found\":\"$(json_str "$WINNER")\",\"remedy\":\"rm $(json_str "$(sh_squote "$WINNER")")\"}"
    if [ "$STATUS" = ok ]; then STATUS=shadowed; EXIT=2; fi
  fi
fi

finish
