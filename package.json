{
  "name": "@princess-pi/wtft",
  "version": "1.0.0",
  "description": "wtft — what the f**k tokens: live cost tracker for Claude Code and Pi harness sessions",
  "license": "MIT-0",
  "author": {
    "name": "Princess Pi",
    "email": "princess-pi@agentic-arts.ai",
    "url": "https://github.com/duppypro"
  },
  "type": "module",
  "bin": {
    "wtft": "./bin/wtft.mjs",
    "wtft-daemon": "./bin/wtft-daemon.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi"
    ]
  },
  "files": [
    "bin/wtft.mjs",
    "bin/wtft-daemon.mjs"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun run tests/run.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "if [ ! -d node_modules/@princess-pi/libs ]; then bun install; fi && bun run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@princess-pi/libs": "git+https://github.com/princess-pi/libs.git#c53fcca773053cac9f5a0705ea3217583a44cda8",
    "@types/node": "^26",
    "@types/wcwidth": "^1",
    "bun-types": "latest",
    "typescript": "^7",
    "wcwidth": "^1.0.1"
  },
  "trustedDependencies": [
    "@princess-pi/libs"
  ]
}
